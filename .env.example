# Salin file ini menjadi .env.local lalu isi dengan kredensial proyek Supabase ANDA.
# Supabase → Project Settings → API Keys:
#   - Project URL         -> NEXT_PUBLIC_SUPABASE_URL
#   - Publishable key     -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   (legacy anon key juga diterima)
#
# DILARANG memasukkan Secret Key / service_role di sini atau di kode frontend.
# Setelah mengubah .env.local, restart `npm run dev` atau redeploy.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
